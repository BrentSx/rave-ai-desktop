{
  "defaultServerUrl": "https://ai.ravealts.com",
  "knownServers": ["https://ai.ravealts.com", "http://localhost:8000"],
  "auth": {
    "mode": "local",
    "remoteBaseUrl": ""
  },
  "server": {
    "autostart": false,
    "cwd": "",
    "command": "py",
    "args": ["-3.14", "-u", "-m", "app"],
    "healthPath": "/api/v1/health",
    "startTimeoutMs": 180000
  },
  "jarvis": {
    "enabled": true,
    "autostart": true,
    "url": "http://127.0.0.1:8900",
    "command": "py",
    "args": ["-3.14", "-u", "-m", "jarvis.serve"],
    "startTimeoutMs": 30000
  }
}
